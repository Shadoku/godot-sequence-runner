<?xml version="1.0" encoding="UTF-8"?>
<!-- Paths through dictionaries: an object's dictionary property ($piece.props)
     and a variable holding a dictionary ($stats), read. "missing" reads a key that is
     not there (an error, null) and goes on. -->
<data>
	<sequence>
		<call method="record" arg0="$piece.props.health" />
		<call method="record" arg0="$stats.bonus" />
		<call method="record" arg0="$stats.nested.deep" />
	</sequence>
	<sequence name="missing">
		<set var="read" value="$piece.props.nope" />
		<call method="ping" />
	</sequence>
</data>
